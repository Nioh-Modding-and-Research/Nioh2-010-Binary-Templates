LittleEndian();

enum<uint> platform {
	SONY_PS2 			= 0x00,
	SONY_PS3 			= 0x01,
	MICROSOFT_X360 		= 0x02,
	NINTENDO_WII 		= 0x03,
	NINTENDO_DS 		= 0x04,
	NINTENDO_3DS 		= 0x05,
	SONY_PSV 			= 0x06,
	GOOGLE_ANDROID		= 0x07,
	APPLE_IOS			= 0x08,
	NINTENDO_WIIU		= 0x09,
	MICROSOFT_WINDOWS	= 0x0A,
	SONY_PS4			= 0x0B,
	MICROSOFT_XONE		= 0x0C,
	NINTENDO_SWITCH		= 0x10,
};

typedef struct {
	char magic[4];
	char version[4];
	uint FileSize;
	uint HeaderSize;
	uint TextureCount;
	platform Plateform;
	uint ASTCSize;
}g1t_header;

typedef struct {
	uint16 Unk1<comment="should be 21">;
	uint16 Unk2<comment="should be 1">;
	int ASTCSubFormat;
}g1t_astc_sub;

typedef struct(uint astcSize) {
	local int j<hidden=true> = 0;
	for (j = 0; j < astcSize/8; j++) {
		g1t_astc_sub ATSC;
	}
}g1t_astc_header;

typedef struct {
	byte z_mipmap : 4;
	byte mipmap : 4;
	byte type;
	byte dx : 4;
	byte dy : 4;
	byte flags1;
	byte flags2;
	byte flags3;
	byte flags4;
	byte extra_data_flag;
	
	if (extra_data_flag > 0){
		uint extraSize;
		float depth;
		uint16 Unk1;
		uint16 Unk2;
		if(extraSize >= 0x10)
			int realWidth;
		if(extraSize >= 0x14)
			int realHight;
	}
	
	local int unpackedWidth = 1 << dx;
	local int unpackedHight =  1 << dy;
	
}g1t_tex_header;

struct {
	g1t_header Header;
	uint TextureFlags[Header.TextureCount];
	local int64 offset_pos<format=hex> = FTell();
	uint Offsets[Header.TextureCount];
	g1t_astc_header ATSCHeader(Header.ASTCSize);
	
	local int i<hidden=true> = 0;
	for (i = 0; i < Header.TextureCount; i++)
	{
		struct {
			local int64 texture_offset = 0;
			texture_offset = ReadUInt(offset_pos + (i * 4)) + offset_pos;
			FSeek(texture_offset);
			g1t_tex_header TextureHeader;
			
			//if (i != Header.TextureCount-1){
			//	local int nextOffset<hidden=true> = 0;
			//	nextOffset = ReadUInt(offset_pos + ((i + 1) * 4)) + offset_pos;
			//}
			//byte rawdata[];
		}g1t_texture;
	}
	
}G1TFile;