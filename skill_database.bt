LittleEndian();

struct Skill_Database {
    struct Header {
        uint Unk;
        uint Count;
    }header;

    struct Skill {
        local ulong POS<hidden=true>;
        POS = FTell();

        uint SkillID;
        uint Unk1;
        uint Unk2;
        uint Unk3;
        uint Unk4;
        uint Unk5;
        uint Unk6;
        uint ThumbnailPointer;
        local string Thumbnail;
        Thumbnail = ReadString(ThumbnailPointer+POS);
        uint Unk7;
        uint Thumbnail2Pointer;
        local string Thumbnail2;
        Thumbnail2 = ReadString(Thumbnail2Pointer+POS);

        uint buffer[45];
    }skill[header.Count]<optimize=false>;
}skill_database;